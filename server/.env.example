# Server Configuration
PORT=5000

# Optional DNS configuration (comma-separated list of DNS servers)
# Default fallback is 1.1.1.1, 1.0.0.1 if your local network fails SRV lookup
# Set to 'system' to bypass and use local default DNS
DNS_SERVERS=1.1.1.1,1.0.0.1

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/blockvote?retryWrites=true&w=majority

# JWT Authentication Secret
# Replace with a strong, secure random string (minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_here

# Designated Administrator Email
# Used by the manual promotion script (`npm run promote-admin`) to grant admin role to an existing registered account
ADMIN_EMAIL=admin@college.edu
